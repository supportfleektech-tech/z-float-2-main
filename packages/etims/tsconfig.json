{
  "compilerOptions": {
    "composite": true, "declaration": true, "declarationMap": true, "rootDir": "src", "outDir": "dist",
    "module": "ESNext", "moduleResolution": "Bundler", "target": "ES2022", "lib": ["ES2022"],
    "strict": true, "noUncheckedIndexedAccess": true, "esModuleInterop": true, "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true, "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src"]
}
