{
  "name": "@zfloat/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "build:capacitor": "next build --config next.config.capacitor.mjs",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "analyze": "ANALYZE=true next build",
    "cap:init": "cap init zfloat com.zfloat.app --web-dir=out",
    "cap:add:ios": "cap add ios",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@next/bundle-analyzer": "^16.4.5",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@zfloat/accounting": "workspace:*",
    "@zfloat/approvals": "workspace:*",
    "@zfloat/audit": "workspace:*",
    "@zfloat/auth": "workspace:*",
    "@zfloat/config": "workspace:*",
    "@zfloat/database": "workspace:*",
    "@zfloat/etims": "workspace:*",
    "@zfloat/kyc": "workspace:*",
