{
  "name": "@zfloat/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "build:capacitor": "next build --config next.config.capacitor.mjs",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "analyze": "ANALYZE=true next build",
    "cap:init": "cap init zfloat com.zfloat.app --web-dir=out",
    "cap:add:ios": "cap add ios",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@next/bundle-analyzer": "^16.4.5",
    "@types/node": "^20.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@zfloat/accounting": "workspace:*",
    "@zfloat/approvals": "workspace:*",
    "@zfloat/audit": "workspace:*",
    "@zfloat/auth": "workspace:*",
    "@zfloat/config": "workspace:*",
    "@zfloat/database": "workspace:*",
    "@zfloat/etims": "workspace:*",
    "@zfloat/kyc": "workspace:*",
    "@zfloat/ledger": "workspace:*",
    "@zfloat/money": "workspace:*",
    "@zfloat/notifications": "workspace:*",
    "@zfloat/observability": "workspace:*",
    "@zfloat/payments-core": "workspace:*",
    "@zfloat/providers": "workspace:*",
    "@zfloat/queue": "workspace:*",
    "@zfloat/secrets": "workspace:*",
    "@zfloat/storage": "workspace:*",
    "@zfloat/support": "workspace:*",
    "@zfloat/validation": "workspace:*",
    "autoprefixer": "^10.4.20",
    "drizzle-orm": "^0.36.4",
    "eslint": "^8.57.1",
    "motion": "^13.2.0",
    "next": "^14.2.15",
    "postcss": "^8.4.45",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "zod": "^3.23.8"
